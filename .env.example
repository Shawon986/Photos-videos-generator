# ==============================================================================
# VisionForge AI — Environment Configuration
# Copy this file to `.env` and adjust values. Never commit `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Development default: SQLite (zero setup, file stored in prisma/dev.db).
# DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL): switch prisma/schema.prisma to the Postgres schema
# (see README "Production deployment") and use a URL like:
# DATABASE_URL="postgresql://visionforge:password@localhost:5432/visionforge?schema=public"
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Secret used to sign session JWTs. Generate one with:
#   npx auth secret    (or: openssl rand -base64 32)
AUTH_SECRET=openssl rand -base64 32

# ------------------------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------------------------
# Which provider serves each media type.
#   image: local | huggingface | openai-compatible | pollinations
#   video: local | huggingface
# If unset (or the provider is unreachable), the app falls back to the demo
# provider ONLY when DEMO_MODE=true. Otherwise generation fails with a clear
# error — the app never pretends a model ran when it did not.
IMAGE_PROVIDER=local
VIDEO_PROVIDER=local

# HTTP endpoints of self-hosted inference servers (see README "Running the
# local AI servers" and scripts/local-image-server.py / local-video-server.py).
# A local GPU inference server can run on a different machine — set its URL.
AI_IMAGE_URL=http://localhost:8000
AI_VIDEO_URL=http://localhost:8001

# Hugging Face Inference API token (free tier available at huggingface.co).
# Used when IMAGE_PROVIDER=huggingface or VIDEO_PROVIDER=huggingface.
HUGGINGFACE_API_KEY=
# Base URL of the Hugging Face Inference API — override when the default
# endpoint is unreachable from your network (regional gateways, proxies).
HF_INFERENCE_URL=https://api-inference.huggingface.co

# OpenAI-compatible image API — works with SiliconFlow (free tier:
# FLUX.1-schnell, SDXL), Together, Novita, or any /v1/images/generations
# endpoint. Used when IMAGE_PROVIDER=openai-compatible.
OPENAI_COMPAT_IMAGE_URL=https://api.siliconflow.cn/v1
OPENAI_COMPAT_API_KEY=

# Pollinations — free community image API (https://pollinations.ai).
# No API key or account needed. Anonymous tier: ~1 request/15s, images may
# carry a watermark; a free account at auth.pollinations.ai lifts both.
# Used when IMAGE_PROVIDER=pollinations.
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai
# Optional app identifier sent as ?referrer= (helps attribute traffic).
POLLINATIONS_REFERRER=

# HTTP(S) proxy for AI provider requests, e.g. "http://127.0.0.1:7890"
# (Clash/v2ray local proxies). Node.js does NOT honor Windows system proxy
# settings — set this explicitly when huggingface.co is blocked and you use
# a proxy-style VPN. TUN-mode VPNs route everything and need no config.
AI_PROXY_URL=

# ------------------------------------------------------------------------------
# Demo mode
# ------------------------------------------------------------------------------
# When true, generations succeed using procedurally generated demo assets if
# no real provider is reachable. Demo results are clearly labelled
# "Demo Preview" in the UI. Set to false to disable the fallback.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
# local = filesystem under UPLOAD_DIR. vercel-blob = Vercel Blob store
# (required on Vercel, whose filesystem is read-only) — needs
# BLOB_READ_WRITE_TOKEN. Additional adapters can be added in lib/storage/.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Vercel Blob read/write token (only when STORAGE_PROVIDER=vercel-blob).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…

# Secret for the Vercel cron endpoint /api/cron/process.
CRON_SECRET=imageandvideogenerator

# Max size (bytes) accepted by POST /api/upload and image-to-video.
MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------------------------
# Rate limiting (per user, per hour)
# ------------------------------------------------------------------------------
IMAGE_GENERATIONS_PER_HOUR=10
VIDEO_GENERATIONS_PER_HOUR=3

# ------------------------------------------------------------------------------
# Background worker
# ------------------------------------------------------------------------------
# In development the worker starts automatically inside the Next.js server.
# In production run it as a separate process: `npm run worker`.
WORKER_AUTO_START=true
# Poll interval for queued jobs, in milliseconds.
WORKER_POLL_INTERVAL_MS=2000
# Maximum attempts per job before it is marked FAILED.
JOB_MAX_ATTEMPTS=2
