{
  "name": "visionforge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "VisionForge AI — free AI image & video generation studio powered by open-source models",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "cp prisma/schema.postgres.prisma prisma/schema.prisma && prisma generate && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
