# ==============================================================================
# VisionForge AI — Vercel production configuration
# Copy each value into Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.
# ==============================================================================

# --- Database (Neon Postgres) -------------------------------------------------
# Create a free project at https://neon.tech → copy the pooled connection
# string (starts with postgresql://). SQLite does NOT work on Vercel.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="<32+ random characters>"

# --- AI provider --------------------------------------------------------------
# Pollinations — free, no key. Anonymous tier is slow (~30-60s/image).
IMAGE_PROVIDER=pollinations
# Videos have no cloud provider wired yet — demo clips are served.
VIDEO_PROVIDER=local
DEMO_MODE=true

# --- Storage (Vercel Blob) ----------------------------------------------------
# Local disk is read-only on Vercel — blob storage is required.
# Vercel dashboard → your project → Storage → Create → Blob → copy the
# BLOB_READ_WRITE_TOKEN.
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Cron ---------------------------------------------------------------------
# Secret for /api/cron/process (any long random string; Vercel cron sends
# Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="<32+ random characters>"

# --- Worker -------------------------------------------------------------------
# The inline worker tick processes jobs inside the create request on Vercel.
WORKER_AUTO_START=true
JOB_MAX_ATTEMPTS=2

# --- Optional ----------------------------------------------------------------
# OPENAI_COMPAT_IMAGE_URL=https://api.siliconflow.com/v1
# OPENAI_COMPAT_API_KEY=sk-...
# IMAGE_GENERATIONS_PER_HOUR=10
# VIDEO_GENERATIONS_PER_HOUR=3
# Vercel limits server request bodies to 4.5MB (Blob server uploads) — keep
# uploads below that. Local dev can use the larger default.
# MAX_UPLOAD_BYTES=4500000
